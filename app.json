{
  "expo": {
    "name": "RetkiRapsa",
    "slug": "RetkiRapsa",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "retkirapsa",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#eeeeee",
      "ios": {
        "image": "./assets/images/icon.png",
        "backgroundColor": "#2c5f2d",
        "resizeMode": "cover"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agasofta.RetkiRapsa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "RetkiRapsa uses your location to show nearby hiking spots and to attach accurate coordinates to your reviews. For example, we use your location to display the closest resting places on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RetkiRapsa uses your location to show nearby hiking spots and to attach accurate coordinates to your reviews. For example, we use your location to display the closest resting places on the map."
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#eeeeee"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "package": "com.agasofta.RetkiRapsa"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID biometric data."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9ad58aa-324e-4d91-be03-1106e862702e"
      }
    }
  }
}
